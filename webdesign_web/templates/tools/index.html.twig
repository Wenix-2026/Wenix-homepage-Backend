{% extends 'base.html.twig' %}

{% block title %}{{ pageTitle }} - E-shop Platform{% endblock %}

{% block content %}
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-gray-600 mb-4">
        <a href="{{ path('app_home_index') }}" class="hover:text-gray-900">Domů</a>
        <span>/</span>
        <span class="font-medium text-gray-900">{{ pageTitle }}</span>
    </nav>

    <!-- Main Content Card -->
    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">{{ pageTitle }}</h1>
                <p class="text-sm text-gray-500 mt-1">Užitečné nástroje pro správu e-shopu</p>
            </div>
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-2">
                    <span class="px-3 py-1 text-sm font-medium bg-orange-100 text-orange-800 rounded-full">Cron: 8</span>
                    <span class="px-3 py-1 text-sm font-medium bg-blue-100 text-blue-800 rounded-full">Reporty: 3</span>
                </div>
            </div>
        </div>

        <!-- Content Area -->
        <div class="flex flex-col items-center justify-center py-12 text-center">
            <div class="w-16 h-16 mb-4 rounded-full bg-orange-50 flex items-center justify-center">
                <svg class="w-8 h-8 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
            </div>
            <h3 class="text-lg font-medium text-gray-900 mb-2">Nástroje</h3>
            <p class="text-sm text-gray-500 max-w-md">
                Používejte utility pro údržbu, skenování a optimalizaci vašeho e-shopu.
            </p>
        </div>
    </div>
{% endblock %}
