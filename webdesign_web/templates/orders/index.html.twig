{% extends 'base.html.twig' %}

{% block title %}{{ pageTitle }} - E-shop Platform{% endblock %}

{% block body %}
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-gray-600 mb-4">
        <a href="{{ path('app_home_index') }}" class="hover:text-gray-900">Domů</a>
        <span>/</span>
        <span class="font-medium text-gray-900">{{ pageTitle }}</span>
    </nav>

    <!-- Main Content Card -->
    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">{{ pageTitle }}</h1>
                <p class="text-sm text-gray-500 mt-1">Přehled všech objednávek a jejich stavů</p>
            </div>
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-2">
                    <span class="px-3 py-1 text-sm font-medium bg-green-100 text-green-800 rounded-full">Dnes: 3</span>
                    <span class="px-3 py-1 text-sm font-medium bg-yellow-100 text-yellow-800 rounded-full">Týden: 12</span>
                </div>
                <a href="#" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                    </svg>
                    Nová objednávka
                </a>
            </div>
        </div>

        <!-- Content Area -->
        <div class="flex flex-col items-center justify-center py-12 text-center">
            <div class="w-16 h-16 mb-4 rounded-full bg-blue-50 flex items-center justify-center">
                <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                </svg>
            </div>
            <h3 class="text-lg font-medium text-gray-900 mb-2">Žádné nové objednávky</h3>
            <p class="text-sm text-gray-500 max-w-md">
                Zde se zobrazují všechny nové objednávky. Klikněte na číslo objednávky pro detail.
            </p>
        </div>
    </div>
{% endblock %}
