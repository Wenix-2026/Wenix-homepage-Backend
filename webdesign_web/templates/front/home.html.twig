{# ════════════════════════════════ SCRIPTS ════════════════════════════════ #}
<script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
<script>
    AOS.init({ duration: 600, easing: 'ease-out-quart', once: true, offset: 50 });

    /* Mobile burger */
    const mobBurger  = document.getElementById('mob-burger');
    const mobileNav  = document.getElementById('mobile-nav');
    const bOpen      = document.getElementById('burger-open');
    const bClose     = document.getElementById('burger-close');

    mobBurger.addEventListener('click', () => {
        const open = mobileNav.classList.toggle('open');
        bOpen.classList.toggle('hidden', open);
        bClose.classList.toggle('hidden', !open);
    });

    mobileNav.querySelectorAll('a').forEach(a => {
        a.addEventListener('click', () => {
            mobileNav.classList.remove('open');
            bOpen.classList.remove('hidden');
            bClose.classList.add('hidden');
        });
    });

    /* Sticky header opacity */
    const hdr = document.querySelector('header');
    window.addEventListener('scroll', () => {
        hdr.style.background = window.scrollY > 8
            ? 'rgba(0,0,0,0.92)'
            : 'rgba(0,0,0,0.75)';
    }, { passive: true });
</script>
