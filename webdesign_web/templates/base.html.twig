            <span class="text-sm text-gray-600 hidden sm:block">
                {{ app.user.email }}
            </span>
                    <a href="{{ path('app_logout') }}"
                       class="inline-flex items-center gap-2 px-3 py-1.5 text-sm font-medium text-white bg-red-500 hover:bg-red-600 rounded-lg transition-colors">
