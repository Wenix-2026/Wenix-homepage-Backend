<!-- Main Layout Container -->
<div class="flex pt-16 h-screen">
    <!-- Sidebar -->
    <aside class="w-64 bg-gray-900 text-gray-300 flex-shrink-0 hidden lg:block">
        <!-- Sidebar Header -->
        <div class="p-5 border-b border-gray-800">
