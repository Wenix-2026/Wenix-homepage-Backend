                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                    </svg>
                </div>
                <span class="text-lg font-bold text-gray-900">E-shop Platform</span>
            </div>
            <button class="p-2 text-gray-600 hover:text-gray-900">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
            </button>
        </div>

        <!-- Banner -->
        <section class="bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-500 px-6 py-8">
            <div class="max-w-7xl mx-auto">
                <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">
                    Rozšiřte své možnosti díky dalším modulům
                </h2>
                <p class="text-indigo-100 text-sm md:text-base max-w-3xl">
                    Prozkoumejte naše kategorie a objevte funkcionality, které váš e-shop učiní ještě výkonnějším.
                    Aktivujte moduly podle svých potřeb a zvyšte konkurenceschopnost.
                </p>
            </div>
        </section>

        <!-- Categories Grid -->
        <section class="px-6 py-6">
            <div class="max-w-7xl mx-auto">
                <h3 class="text-lg font-semibold text-gray-800 mb-4">Kategorie</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    {% for category in categories|default([]) %}
