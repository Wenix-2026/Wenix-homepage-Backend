                </svg>
                <button class="absolute right-2 top-1.5 p-1 text-gray-500 hover:text-white transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Sidebar Navigation -->
        <nav class="p-4 space-y-1">
            <!-- Kategorie sekce -->
            <div class="mb-6">
                <h3 class="px-3 text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Kategorie</h3>
                <div id="category-list" class="space-y-1">
                    {% for category in categories|default([]) %}
                        <a href="{{ path('app_home_index', {'active_category_id': category.id}) }}" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-gray-800 transition-colors {% if category.id == app.active_category_id ?? null %}bg-gray-800 text-white{% else %}text-gray-400 hover:text-white{% endif %}">
                            <i class="{{ category.icon_class|default('bx bx-box') }}"></i>
                            <span class="text-sm">{{ category.name }}</span>
                        </a>
                    {% endfor %}
                </div>
            </div>

            <!-- Doporučujeme sekce -->
            <div>
                <h3 class="px-3 text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Doporučujeme</h3>
                <div id="recommended-list" class="space-y-1">
                    {% for module in recommended_modules|default([]) %}
