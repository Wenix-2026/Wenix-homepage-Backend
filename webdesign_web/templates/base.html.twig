            <p class="text-xs text-gray-500">Rozšiřte své možnosti</p>
        </div>

        <!-- Search Bar -->
        <div class="p-4 border-b border-gray-800">
            <div class="relative">
                <input type="text" placeholder="Vyhledat modul..."
                       class="w-full px-4 py-2 pl-10 text-sm text-gray-300 bg-gray-800 border border-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent placeholder-gray-500">
                <svg class="absolute left-3 top-2.5 w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
