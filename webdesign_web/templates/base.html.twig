                            <div class="w-16 h-16 mb-4 rounded-xl bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center group-hover:from-indigo-50 group-hover:to-purple-50 transition-colors">
                                <i class="{{ category.icon_class|default('bx bx-box') }}"></i>
                            </div>
                            <h4 class="text-base font-medium text-gray-900 text-center mb-1">{{ category.name }}</h4>
                            <span class="text-sm text-gray-500">{{ category.total_count|default(0) }} modulů</span>
                        </a>
                    {% endfor %}
                </div>
            </div>
        </section>

        <!-- Recommended Modules -->
        <section class="px-6 py-6 pb-8">
            <div class="max-w-7xl mx-auto">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-lg font-semibold text-gray-800">Doporučujeme</h3>
                    <a href="#" class="text-sm font-medium text-indigo-600 hover:text-indigo-700 transition-colors">
                        Zobrazit všechny
                    </a>
                </div>

                <div class="space-y-3">
                    {% for module in recommended_modules|default([]) %}
                        <div class="flex items-center gap-4 p-4 bg-white border border-gray-200 rounded-xl hover:border-indigo-300 hover:shadow-sm transition-all duration-200 group {% if not module.is_active|default(true) %}opacity-75{% endif %}">
                            <!-- Colored Icon -->
                            <div class="flex-shrink-0 w-12 h-12 rounded-lg {% if module.badge_class %}{{ module.badge_class }}{% else %}bg-gray-100{% endif %} flex items-center justify-center">
                                <i class="{{ module.icon_class|default('bx bx-box') }}"></i>
                            </div>

                            <!-- Content -->
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2 mb-1">
                                    <h4 class="text-base font-medium text-gray-900 group-hover:text-indigo-600 transition-colors">
                                        {{ module.name }}
                                    </h4>
                                    {% if module.is_active|default(true) %}
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                            Aktivní
                                        </span>
                                    {% endif %}
                                    {% if module.is_recommended|default(false) %}
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                            Doporučujeme
                                        </span>
                                    {% endif %}
                                </div>
                                <p class="text-sm text-gray-600">{{ module.description }}</p>
                            </div>

                            <!-- Action Button -->
                            <div class="flex-shrink-0">
                                <a href="#" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition-colors {% if not module.is_active|default(true) %}opacity-50 cursor-not-allowed{% endif %}">
                                    <span>Detail modulu</span>
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                                    </svg>
                                </a>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>

        <!-- Footer (optional) -->
        <footer class="px-6 py-4 bg-gray-50 border-t border-gray-200">
            <div class="max-w-7xl mx-auto flex items-center justify-between text-sm text-gray-500">
                <p>&copy; 2026 E-shop Platform. Všechna práva vyhrazena.</p>
                <div class="flex items-center gap-4">
                    <a href="#" class="hover:text-gray-700 transition-colors">Podpora</a>
                    <a href="{{ path('app_privacy_policy') }}" class="hover:text-gray-700 transition-colors">Privacy</a>
                    <a href="{{ path('app_cookie_policy') }}" class="hover:text-gray-700 transition-colors">Podmínky</a>
                </div>
            </div>
        </footer>
    </main>
</div>

{% block javascript %}
<script>
    (function() {
    // Pomocná funkce pro zápis cookie
    function setCookie(name, value, days) {
        const expires = new Date(Date.now() + days * 864e5).toUTCString();
        document.cookie = `${name}=${encodeURIComponent(value)};expires=${expires};path=/;SameSite=Lax`;
    }

    // Pomocná funkce pro čtení cookie
    function getCookie(name) {
    return document.cookie.split('; ').reduce((acc, c) => {
    const [k, v] = c.split('=');
    return k === name ? decodeURIComponent(v) : acc;
}, null);
}

    // Načti skripty podle souhlasu
    function loadConsentedScripts(consentValue) {
    const hasAnalytics  = consentValue.includes('analytics');
    const hasMarketing  = consentValue.includes('marketing');

    if (hasAnalytics) {
    // Google Analytics — načte se až po souhlasu
    const script = document.createElement('script');
    script.src = 'https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX';
    script.async = true;
    document.head.appendChild(script);

    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-XXXXXXXXXX');
}

    if (hasMarketing) {
    // Marketingové skripty (Facebook Pixel atd.)
    // fbq('init', 'PIXEL_ID');
}
}

    const banner = document.getElementById('cookie-banner');
    const modal  = document.getElementById('cookie-modal');
    const existing = getCookie('wda_cookie_consent');

    // Pokud souhlas již existuje — načti skripty okamžitě
    if (existing) {
    loadConsentedScripts(existing);
    return; // Banner se nezobrazí (Twig ho ani nevyrenderoval)
}

    if (!banner) return;

    // Přijmout vše
    document.getElementById('cookie-accept')?.addEventListener('click', () => {
    setCookie('wda_cookie_consent', 'necessary_analytics_marketing', 365);
    loadConsentedScripts('necessary_analytics_marketing');
    banner.remove();
});

    // Odmítnout — pouze nezbytné
    document.getElementById('cookie-reject')?.addEventListener('click', () => {
    setCookie('wda_cookie_consent', 'necessary', 365);
    banner.remove();
});

    // Otevřít nastavení
    document.getElementById('cookie-settings')?.addEventListener('click', () => {
    if (modal) modal.classList.remove('hidden');
});

    // Zavřít modal
    document.getElementById('cookie-modal-close')?.addEventListener('click', () => {
    if (modal) modal.classList.add('hidden');
});

    // Uložit vlastní nastavení
    document.getElementById('cookie-save-settings')?.addEventListener('click', () => {
    const analytics = document.getElementById('toggle-analytics')?.checked;
    const marketing = document.getElementById('toggle-marketing')?.checked;

    const parts = ['necessary'];
    if (analytics) parts.push('analytics');
    if (marketing) parts.push('marketing');

    const consentValue = parts.join('_');
    setCookie('wda_cookie_consent', consentValue, 365);
    loadConsentedScripts(consentValue);

    if (modal) modal.classList.add('hidden');
    if (banner) banner.remove();
});

    // Zavřít modal kliknutím mimo
    modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.classList.add('hidden');
});
})();
</script>
{% endblock %}
</body>
</html>
