<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Administrace{% endblock %}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    {% set active_category_id = app.active_category_id ?? 1 %}
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel="stylesheet">
    {% block styles %}{% endblock %}
</head>
<body class="bg-gray-50 font-sans antialiased">
<!-- Top Navigation Bar -->
<header class="fixed top-0 left-0 right-0 z-50 bg-white shadow-sm border-b border-gray-200">
    <div class="flex items-center justify-between px-4 h-16">
        <!-- Logo -->
        <div class="flex items-center gap-3">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-indigo-600 to-purple-600 flex items-center justify-center">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                    </svg>
                </div>
                <span class="text-xl font-bold text-gray-900">E-shop Admin</span>
            </div>
        </div>

        <!-- Main Navigation -->
        <nav class="hidden md:flex items-center gap-1">
            <a href="{{ path('app_home_index') }}" class="px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition-colors {% if app.request.attributes.get('_route') == 'app_home_index' %}bg-indigo-600{% endif %}">
                Administrace
            </a>
            <a href="{{ path('app_products_index') }}" class="px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 rounded-lg transition-colors {% if app.request.attributes.get('_route') == 'app_products_index' %}bg-indigo-600 text-white{% endif %}">
                Zboží
            </a>
            <a href="{{ path('app_orders_index') }}" class="px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 rounded-lg transition-colors {% if app.request.attributes.get('_route') == 'app_orders_index' %}bg-indigo-600 text-white{% endif %}">
                Objednávky
            </a>
            <a href="{{ path('app_stock_index') }}" class="px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 rounded-lg transition-colors {% if app.request.attributes.get('_route') == 'app_stock_index' %}bg-indigo-600 text-white{% endif %}">
                Sklad
            </a>
            <a href="{{ path('app_content_index') }}" class="px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 rounded-lg transition-colors {% if app.request.attributes.get('_route') == 'app_content_index' %}bg-indigo-600 text-white{% endif %}">
                Obsah
            </a>
            <a href="{{ path('app_tools_index') }}" class="px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 rounded-lg transition-colors {% if app.request.attributes.get('_route') == 'app_tools_index' %}bg-indigo-600 text-white{% endif %}">
                Nástroje
            </a>
            <a href="{{ path('app_settings_index') }}" class="px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 rounded-lg transition-colors {% if app.request.attributes.get('_route') == 'app_settings_index' %}bg-indigo-600 text-white{% endif %}">
                Nastavení
            </a>
            <a href="{{ path('app_translations_index') }}" class="px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 rounded-lg transition-colors {% if app.request.attributes.get('_route') == 'app_translations_index' %}bg-indigo-600 text-white{% endif %}">
                Překlady
            </a>
        </nav>

        <!-- Right Side Links -->
        <div class="flex items-center gap-4">
            <a href="http://localhost:8000" class="text-sm font-medium text-gray-700 hover:text-gray-900 transition-colors hidden sm:block">
                E-shop
            </a>
            <a href="#" class="text-sm font-medium text-gray-700 hover:text-gray-900 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12c0 1.551-1.449 2.8-3.2 2.8-1.115 0-2.128-.722-2.882-1.768l-3.637 3.637a4.5 4.5 0 1 1-6.364-6.364l3.637-3.637a3.89 3.89 0 0 1 1.04-1.04l-3.637-3.637a4.5 4.5 0 1 1 6.364-6.364l3.637 3.637a3.89 3.89 0 0 1-1.04 1.04M6 12a6 6 0 1 0 12 0 6 6 0 0 0-12 0Z"/>
                </svg>
            </a>
        </div>
    </div>
</header>

<!-- Main Layout Container -->
<div class="flex pt-16 h-screen">
    <!-- Sidebar -->
    <aside class="w-64 bg-gray-900 text-gray-300 flex-shrink-0 hidden lg:block">
        <!-- Sidebar Header -->
        <div class="p-5 border-b border-gray-800">
            <h1 class="text-lg font-semibold text-white mb-1">Modulovna</h1>
            <p class="text-xs text-gray-500">Rozšiřte své možnosti</p>
        </div>

        <!-- Search Bar -->
        <div class="p-4 border-b border-gray-800">
            <div class="relative">
                <input type="text" placeholder="Vyhledat modul..."
                       class="w-full px-4 py-2 pl-10 text-sm text-gray-300 bg-gray-800 border border-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent placeholder-gray-500">
                <svg class="absolute left-3 top-2.5 w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
                <button class="absolute right-2 top-1.5 p-1 text-gray-500 hover:text-white transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Sidebar Navigation -->
        <nav class="p-4 space-y-1">
            <!-- Kategorie sekce -->
            <div class="mb-6">
                <h3 class="px-3 text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Kategorie</h3>
                <div id="category-list" class="space-y-1">
                    {% for category in categories|default([]) %}
                        <a href="{{ path('app_home_index', {'active_category_id': category.id}) }}" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-gray-800 transition-colors {% if category.id == app.active_category_id ?? null %}bg-gray-800 text-white{% else %}text-gray-400 hover:text-white{% endif %}">
                            <i class="{{ category.icon_class|default('bx bx-box') }}"></i>
                            <span class="text-sm">{{ category.name }}</span>
                        </a>
                    {% endfor %}
                </div>
            </div>

            <!-- Doporučujeme sekce -->
            <div>
                <h3 class="px-3 text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Doporučujeme</h3>
                <div id="recommended-list" class="space-y-1">
                    {% for module in recommended_modules|default([]) %}
                        <a href="{{ path('app_home_index', {'active_module_id': module.id}) }}" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-gray-800 transition-colors {% if module.id == app.active_module_id ?? null %}bg-gray-800 text-white{% else %}text-gray-400 hover:text-white{% endif %}">
                            <i class="{{ module.icon_class|default('bx bx-box') }}"></i>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm truncate">{{ module.name }}</p>
                                <p class="text-xs text-gray-600 truncate">{{ module.description|slice(0, 50) }}</p>
                            </div>
                            <button class="text-gray-600 hover:text-indigo-400 transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                            </button>
                        </a>
                    {% endfor %}
                </div>
            </div>
        </nav>

        <!-- User Profile (bottom of sidebar) -->
        <div class="p-4 border-t border-gray-800">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-white truncate">Administrátor</p>
                    <p class="text-xs text-gray-500 truncate">admin@eshop.cz</p>
                </div>
            </div>
        </div>
    </aside>

    <!-- Main Content Area -->
    <main class="flex-1 overflow-y-auto">
        <!-- Mobile Header (visible only on small screens) -->
        <div class="lg:hidden sticky top-0 z-40 bg-white border-b border-gray-200 px-4 py-3 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-indigo-600 to-purple-600 flex items-center justify-center">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                    </svg>
                </div>
                <span class="text-lg font-bold text-gray-900">E-shop Platform</span>
            </div>
            <button class="p-2 text-gray-600 hover:text-gray-900">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
            </button>
        </div>

        <!-- Banner -->
        <section class="bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-500 px-6 py-8">
            <div class="max-w-7xl mx-auto">
                <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">
                    Rozšiřte své možnosti díky dalším modulům
                </h2>
                <p class="text-indigo-100 text-sm md:text-base max-w-3xl">
                    Prozkoumejte naše kategorie a objevte funkcionality, které váš e-shop učiní ještě výkonnějším.
                    Aktivujte moduly podle svých potřeb a zvyšte konkurenceschopnost.
                </p>
            </div>
        </section>

        <!-- Categories Grid -->
        <section class="px-6 py-6">
            <div class="max-w-7xl mx-auto">
                <h3 class="text-lg font-semibold text-gray-800 mb-4">Kategorie</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    {% for category in categories|default([]) %}
                        <a href="{{ path('app_home_index', {'active_category_id': category.id}) }}" class="group flex flex-col items-center p-6 bg-white border border-gray-200 rounded-xl hover:border-indigo-300 hover:shadow-md transition-all duration-200 {% if category.id == app.active_category_id ?? null %}ring-2 ring-indigo-500{% endif %}">
                            <div class="w-16 h-16 mb-4 rounded-xl bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center group-hover:from-indigo-50 group-hover:to-purple-50 transition-colors">
                                <i class="{{ category.icon_class|default('bx bx-box') }}"></i>
                            </div>
                            <h4 class="text-base font-medium text-gray-900 text-center mb-1">{{ category.name }}</h4>
                            <span class="text-sm text-gray-500">{{ category.total_count|default(0) }} modulů</span>
                        </a>
                    {% endfor %}
                </div>
            </div>
        </section>

        <!-- Recommended Modules -->
        <section class="px-6 py-6 pb-8">
            <div class="max-w-7xl mx-auto">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-lg font-semibold text-gray-800">Doporučujeme</h3>
                    <a href="#" class="text-sm font-medium text-indigo-600 hover:text-indigo-700 transition-colors">
                        Zobrazit všechny
                    </a>
                </div>

                <div class="space-y-3">
                    {% for module in recommended_modules|default([]) %}
                        <div class="flex items-center gap-4 p-4 bg-white border border-gray-200 rounded-xl hover:border-indigo-300 hover:shadow-sm transition-all duration-200 group {% if not module.is_active|default(true) %}opacity-75{% endif %}">
                            <!-- Colored Icon -->
                            <div class="flex-shrink-0 w-12 h-12 rounded-lg {% if module.badge_class %}{{ module.badge_class }}{% else %}bg-gray-100{% endif %} flex items-center justify-center">
                                <i class="{{ module.icon_class|default('bx bx-box') }}"></i>
                            </div>

                            <!-- Content -->
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2 mb-1">
                                    <h4 class="text-base font-medium text-gray-900 group-hover:text-indigo-600 transition-colors">
                                        {{ module.name }}
                                    </h4>
                                    {% if module.is_active|default(true) %}
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                            Aktivní
                                        </span>
                                    {% endif %}
                                    {% if module.is_recommended|default(false) %}
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                            Doporučujeme
                                        </span>
                                    {% endif %}
                                </div>
                                <p class="text-sm text-gray-600">{{ module.description }}</p>
                            </div>

                            <!-- Action Button -->
                            <div class="flex-shrink-0">
                                <a href="#" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition-colors {% if not module.is_active|default(true) %}opacity-50 cursor-not-allowed{% endif %}">
                                    <span>Detail modulu</span>
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                                    </svg>
                                </a>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>

        <!-- Footer (optional) -->
        <footer class="px-6 py-4 bg-gray-50 border-t border-gray-200">
            <div class="max-w-7xl mx-auto flex items-center justify-between text-sm text-gray-500">
                <p>&copy; 2026 E-shop Platform. Všechna práva vyhrazena.</p>
                <div class="flex items-center gap-4">
                    <a href="#" class="hover:text-gray-700 transition-colors">Podpora</a>
                    <a href="#" class="hover:text-gray-700 transition-colors">Privacy</a>
                    <a href="#" class="hover:text-gray-700 transition-colors">Podmínky</a>
                </div>
            </div>
        </footer>
    </main>
</div>

{% block javascript %}{% endblock %}
</body>
</html>
