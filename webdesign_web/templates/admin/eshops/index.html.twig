{% extends 'base.html.twig' %}
{% block title %}Správa e-shopů{% endblock %}

{% block content %}
    <div class="p-6 max-w-7xl mx-auto">

        {# Flash zprávy #}
        {% for msg in app.flashes('success') %}
            <div class="mb-4 px-4 py-3 bg-green-50 border border-green-200 text-green-700 text-sm rounded-lg flex items-center gap-2">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                {{ msg }}
            </div>
        {% endfor %}
        {% for msg in app.flashes('error') %}
            <div class="mb-4 px-4 py-3 bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg flex items-center gap-2">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                {{ msg }}
            </div>
        {% endfor %}

        {# Header #}
        <div class="flex items-center justify-between mb-6">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Správa e-shopů</h1>
                <p class="text-sm text-gray-500 mt-1">Celkem {{ eshops|length }} e-shopů</p>
            </div>
            <button onclick="document.getElementById('modal-add').classList.remove('hidden')"
                    class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium rounded-lg transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                Přidat e-shop
            </button>
        </div>

        {# Tabulka #}
        <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
            <table class="w-full text-sm">
                <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Název</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Doména</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Přidáno</th>
                    <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Akce</th>
                </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                {% for eshop in eshops %}
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-6 py-4 font-medium text-gray-900">{{ eshop.name }}</td>
                        <td class="px-6 py-4 text-gray-500 font-mono text-xs">{{ eshop.domain }}</td>
                        <td class="px-6 py-4 text-gray-400 text-xs">{{ eshop.createdAt|date('d.m.Y') }}</td>
                        <td class="px-6 py-4 text-right">
                            <button onclick="openDeleteEshop('{{ eshop.id }}', '{{ eshop.name|e('js') }}', '{{ csrf_token('eshop_delete_' ~ eshop.id) }}')"
                                    class="p-1.5 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors"
                                    title="Smazat">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                            </button>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="px-6 py-12 text-center text-gray-400">
                            <svg class="w-10 h-10 mx-auto mb-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            <p class="font-medium">Žádné e-shopy</p>
                            <p class="text-xs mt-1">Přidejte první e-shop kliknutím na tlačítko výše.</p>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

    </div>

    {# ── MODAL: Přidat e-shop ── #}
    <div id="modal-add" class="hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-md p-6">
            <div class="flex items-center justify-between mb-5">
                <h2 class="text-lg font-bold text-gray-900">Přidat e-shop</h2>
                <button onclick="document.getElementById('modal-add').classList.add('hidden')"
                        class="p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
            <form method="post" action="{{ path('admin_eshops_new') }}" class="space-y-4">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('eshop_new') }}">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Název e-shopu <span class="text-red-500">*</span></label>
                    <input type="text" name="name" required placeholder="Můj e-shop s.r.o."
                           class="w-full px-4 py-2.5 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 transition">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Doména <span class="text-red-500">*</span></label>
                    <input type="text" name="domain" required placeholder="mujeshop.cz"
                           class="w-full px-4 py-2.5 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 transition">
                </div>
                <div class="flex gap-3 pt-2">
                    <button type="button" onclick="document.getElementById('modal-add').classList.add('hidden')"
                            class="flex-1 py-2.5 text-sm font-medium text-gray-700 border border-gray-300 hover:bg-gray-50 rounded-lg transition-colors">
                        Zrušit
                    </button>
                    <button type="submit"
                            class="flex-1 py-2.5 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg transition-colors">
                        Přidat e-shop
                    </button>
                </div>
            </form>
        </div>
    </div>

    {# ── MODAL: Smazat e-shop ── #}
    <div id="modal-delete" class="hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-md p-6">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                </div>
                <div>
                    <h2 class="text-lg font-bold text-gray-900">Smazat e-shop</h2>
                    <p class="text-xs text-gray-500">Tato akce je nevratná.</p>
                </div>
            </div>

            <p class="text-sm text-gray-600 mb-4">
                Pro potvrzení smazání napište přesný název e-shopu:
                <strong id="delete-eshop-name" class="text-gray-900"></strong>
            </p>

            <form id="delete-eshop-form" method="post" class="space-y-4">
                <input type="hidden" name="_csrf_token" id="delete-csrf-token">
                <input type="text" name="confirm_name" id="delete-confirm-input" required
                       placeholder="Napište název e-shopu..."
                       class="w-full px-4 py-2.5 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 transition">
                <div class="flex gap-3">
                    <button type="button" onclick="document.getElementById('modal-delete').classList.add('hidden')"
                            class="flex-1 py-2.5 text-sm font-medium text-gray-700 border border-gray-300 hover:bg-gray-50 rounded-lg transition-colors">
                        Zrušit
                    </button>
                    <button type="submit"
                            class="flex-1 py-2.5 text-sm font-medium text-white bg-red-600 hover:bg-red-700 rounded-lg transition-colors">
                        Smazat
                    </button>
                </div>
            </form>
        </div>
    </div>

{% endblock %}

{% block javascript %}
<script>
    function openDeleteEshop(id, name, csrf) {
    document.getElementById('delete-eshop-name').textContent = name;
    document.getElementById('delete-csrf-token').value = csrf;
    document.getElementById('delete-confirm-input').value = '';
    document.getElementById('delete-eshop-form').action = '/admin/eshops/' + id + '/delete';
    document.getElementById('modal-delete').classList.remove('hidden');
}

    // Zavření modalů kliknutím mimo
    ['modal-add', 'modal-delete'].forEach(id => {
    document.getElementById(id)?.addEventListener('click', function(e) {
        if (e.target === this) this.classList.add('hidden');
    });
});
</script>
{% endblock %}
