{% extends 'base.html.twig' %}
{% block title %}Podpora — Tickety{% endblock %}

{% block content %}
    <div class="p-6 max-w-7xl mx-auto">

        {% for msg in app.flashes('success') %}
            <div class="mb-4 px-4 py-3 bg-green-50 border border-green-200 text-green-700 text-sm rounded-lg flex items-center gap-2">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                {{ msg }}
            </div>
        {% endfor %}
        {% for msg in app.flashes('error') %}
            <div class="mb-4 px-4 py-3 bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg flex items-center gap-2">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                {{ msg }}
            </div>
        {% endfor %}

        <div class="flex items-center justify-between mb-6">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Podpora</h1>
                <p class="text-sm text-gray-500 mt-1">Celkem {{ tickets|length }} ticketů</p>
            </div>
            <button onclick="document.getElementById('modal-ticket').classList.remove('hidden')"
                    class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium rounded-lg transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                Nový ticket
            </button>
        </div>

        <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
            <table class="w-full text-sm">
                <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">#</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Typ</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Kategorie</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">E-shop</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Zpráva</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Stav</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Datum</th>
                    <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Akce</th>
                </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                {% for ticket in tickets %}
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-6 py-4 text-gray-400 text-xs font-mono">#{{ ticket.id }}</td>
                        <td class="px-6 py-4">
                            {% set type_colors = {'Žádost': 'bg-blue-100 text-blue-800', 'Stížnost': 'bg-red-100 text-red-800', 'Podpora': 'bg-purple-100 text-purple-800'} %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium {{ type_colors[ticket.type] ?? 'bg-gray-100 text-gray-700' }}">
                            {{ ticket.type }}
                        </span>
                        </td>
                        <td class="px-6 py-4 text-gray-500 text-xs">{{ ticket.category ?? '—' }}</td>
                        <td class="px-6 py-4 text-gray-500 text-xs font-mono">{{ ticket.targetEshop ?? '—' }}</td>
                        <td class="px-6 py-4 text-gray-600 max-w-xs truncate text-xs">{{ ticket.message }}</td>
                        <td class="px-6 py-4">
                            {% set status_colors = {'Nový': 'bg-yellow-100 text-yellow-800', 'Odpovězeno': 'bg-blue-100 text-blue-800', 'Vyřešen': 'bg-green-100 text-green-800', 'Zamítnut': 'bg-red-100 text-red-800'} %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium {{ status_colors[ticket.status] ?? 'bg-gray-100 text-gray-700' }}">
                            {{ ticket.status }}
                        </span>
                        </td>
                        <td class="px-6 py-4 text-gray-400 text-xs">{{ ticket.createdAt|date('d.m.Y H:i') }}</td>
                        <td class="px-6 py-4 text-right">
                            <button onclick="openTicketChat({{ ticket.id }}, '#{{ ticket.id }} — {{ ticket.type|e('js') }}', '{{ ticket.status|e('js') }}', '{{ ticket.userEmail|e('js') }}')"
                                    class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-indigo-600 hover:text-white hover:bg-indigo-600 border border-indigo-200 hover:border-indigo-600 rounded-lg transition-colors">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
                                Chat
                            </button>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="px-6 py-12 text-center text-gray-400">
                            <svg class="w-10 h-10 mx-auto mb-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
                            <p class="font-medium">Žádné tickety</p>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

    </div>

    {# ── MODAL: Nový ticket ── #}
    <div id="modal-ticket" class="hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-lg p-6 max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between mb-5">
                <h2 class="text-lg font-bold text-gray-900">Nový ticket</h2>
                <button onclick="document.getElementById('modal-ticket').classList.add('hidden')"
                        class="p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
            <form method="post" action="{{ path('admin_support_new') }}" class="space-y-4">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('ticket_new') }}">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Typ ticketu <span class="text-red-500">*</span></label>
                    <select name="type" id="ticket-type" required onchange="handleTypeChange(this.value)"
                            class="w-full px-4 py-2.5 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white transition">
                        <option value="">— Vyberte typ —</option>
                        <option value="Žádost">Žádost</option>
                        <option value="Stížnost">Stížnost</option>
                        <option value="Podpora">Podpora</option>
                    </select>
                </div>
                <div id="field-category">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Kategorie</label>
                    <select name="category" id="ticket-category"
                            class="w-full px-4 py-2.5 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white transition">
                        <option value="">— Nejprve vyberte typ —</option>
                    </select>
                </div>
                <div id="field-eshop" class="hidden">
                    <label class="block text-sm font-medium text-gray-700 mb-1">E-shop <span class="text-red-500">*</span></label>
                    <select name="target_eshop" id="ticket-eshop"
                            class="w-full px-4 py-2.5 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white transition">
                        <option value="">— Vyberte e-shop —</option>
                        {% for eshop in eshops %}
                            <option value="{{ eshop.domain }}">{{ eshop.name }} ({{ eshop.domain }})</option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Zpráva <span class="text-red-500">*</span></label>
                    <textarea name="message" required rows="4" placeholder="Popište váš požadavek..."
                              class="w-full px-4 py-2.5 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 transition resize-none"></textarea>
                </div>
                <div class="flex gap-3 pt-2">
                    <button type="button" onclick="document.getElementById('modal-ticket').classList.add('hidden')"
                            class="flex-1 py-2.5 text-sm font-medium text-gray-700 border border-gray-300 hover:bg-gray-50 rounded-lg transition-colors">Zrušit</button>
                    <button type="submit"
                            class="flex-1 py-2.5 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg transition-colors">Odeslat ticket</button>
                </div>
            </form>
        </div>
    </div>

    {# ── MODAL: Chat / Detail ticketu ── #}
    <div id="modal-chat" class="hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-2xl flex flex-col" style="max-height: 85vh;">

            {# Header #}
            <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 flex-shrink-0">
                <div>
                    <h2 class="text-base font-bold text-gray-900" id="chat-title">Ticket</h2>
                    <div class="flex items-center gap-2 mt-0.5">
                        <span id="chat-status-badge" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700"></span>
                        <span class="text-xs text-gray-400" id="chat-user-email"></span>
                    </div>
                </div>
                <button onclick="document.getElementById('modal-chat').classList.add('hidden')"
                        class="p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            {# Zprávy #}
            <div id="chat-messages" class="flex-1 overflow-y-auto px-6 py-4 space-y-3 bg-gray-50">
                <div class="text-center text-gray-400 text-sm py-8" id="chat-loading">Načítám zprávy...</div>
            </div>

            {# Formulář pro odpověď #}
            <div class="px-6 py-4 border-t border-gray-100 flex-shrink-0 bg-white rounded-b-2xl">
                <form id="form-reply" class="flex gap-3 items-end">
                    <input type="hidden" name="_csrf_token" id="reply-csrf-token">
                    <input type="hidden" name="ticket_id" id="reply-ticket-id">
                    <textarea id="reply-message" name="message" rows="2" placeholder="Napište odpověď..."
                              class="flex-1 px-4 py-2.5 text-sm border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 transition resize-none"></textarea>
                    <button type="submit"
                            class="flex-shrink-0 px-5 py-2.5 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl transition-colors">
                        Odeslat
                    </button>
                </form>
            </div>

        </div>
    </div>

    <div id="csrf-tokens" class="hidden">
        {% for ticket in tickets %}
            <span data-ticket="{{ ticket.id }}" data-token="{{ csrf_token('ticket_reply_' ~ ticket.id) }}"></span>
        {% endfor %}
    </div>

{% endblock %}

{% block javascript %}
<script>
    const currentUserEmail = '{{ user_email|e('js') }}';

// ── Dynamické kategorie ──
const categories = {
    'Žádost':   ['Nový web', 'Úprava webu', 'Jiné'],
    'Stížnost': ['Pomalý server', 'Něco nefunguje', 'Jiné'],
    'Podpora':  [],
};

function handleTypeChange(type) {
    const catField    = document.getElementById('field-category');
    const catSelect   = document.getElementById('ticket-category');
    const eshopField  = document.getElementById('field-eshop');
    const eshopSelect = document.getElementById('ticket-eshop');

    catSelect.innerHTML = '';
    eshopField.classList.add('hidden');
    eshopSelect.required = false;

    if (type === 'Podpora') {
        catField.classList.add('hidden');
        eshopField.classList.remove('hidden');
        eshopSelect.required = true;
    } else {
        catField.classList.remove('hidden');
        const opts = categories[type] ?? [];
        catSelect.innerHTML = '<option value="">— Vyberte kategorii —</option>';
        opts.forEach(opt => {
            const o = document.createElement('option');
            o.value = opt; o.textContent = opt;
            catSelect.appendChild(o);
        });
    }
}

// ── Chat modal ──
const statusColors = {
    'Nový':        'bg-yellow-100 text-yellow-800',
    'Odpovězeno':  'bg-blue-100 text-blue-800',
    'Vyřešen':     'bg-green-100 text-green-800',
    'Zamítnut':    'bg-red-100 text-red-800',
};

function renderMessages(messages) {
    const container = document.getElementById('chat-messages');

    if (!messages.length) {
        container.innerHTML = '<div class="text-center text-gray-400 text-sm py-8">Žádné zprávy</div>';
        return;
    }

    container.innerHTML = messages.map(msg => {
        const isMine = msg.senderEmail === currentUserEmail;
        const align  = isMine ? 'items-end' : 'items-start';
        const bubble = isMine
            ? 'bg-indigo-600 text-white rounded-2xl rounded-br-sm'
            : 'bg-white text-gray-800 border border-gray-200 rounded-2xl rounded-bl-sm shadow-sm';
        const meta   = isMine
            ? `<span class="text-xs text-gray-400 mt-1">${msg.createdAt}</span>`
            : `<span class="text-xs text-gray-400 mt-1">${msg.senderEmail} · ${msg.createdAt}</span>`;

        return `
            <div class="flex flex-col ${align}">
                <div class="max-w-[75%] px-4 py-2.5 text-sm ${bubble}">
                    ${msg.message.replace(/\n/g, '<br>')}
                </div>
                ${meta}
            </div>`;
    }).join('');

    // Scroll na konec
    container.scrollTop = container.scrollHeight;
}

async function openTicketChat(ticketId, title, status, userEmail) {
    const modal = document.getElementById('modal-chat');

    // Nastav header
    document.getElementById('chat-title').textContent      = title;
    document.getElementById('chat-user-email').textContent = userEmail;
    document.getElementById('reply-ticket-id').value       = ticketId;
    document.getElementById('reply-csrf-token').value      = ''; // reset
    const csrfEl = document.querySelector(`#csrf-tokens [data-ticket="${ticketId}"]`);
    document.getElementById('reply-csrf-token').value = csrfEl?.dataset.token ?? '';

    const badge = document.getElementById('chat-status-badge');
    badge.textContent = status;
    badge.className   = 'inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ' + (statusColors[status] ?? 'bg-gray-100 text-gray-700');

    // Nastav action pro form reply
    document.getElementById('form-reply').dataset.ticketId = ticketId;

    // Zobraz modal
    modal.classList.remove('hidden');
    document.getElementById('chat-loading').style.display = 'block';

    // Načti zprávy
    try {
        const res  = await fetch(`/admin/support/${ticketId}/messages`);
        const data = await res.json();

        // Nastav CSRF token pro reply
        // Musíme ho získat přes endpoint nebo embedded do stránky
        renderMessages(data.messages ?? []);
    } catch (e) {
        document.getElementById('chat-messages').innerHTML =
            '<div class="text-center text-red-400 text-sm py-8">Chyba při načítání zpráv.</div>';
    }
}

// ── Odeslání odpovědi ──
document.getElementById('form-reply')?.addEventListener('submit', async function(e) {
    e.preventDefault();

    const ticketId  = this.dataset.ticketId;
    const message   = document.getElementById('reply-message').value.trim();
    const submitBtn = this.querySelector('[type="submit"]');

    if (!message) return;

    submitBtn.disabled    = true;
    submitBtn.textContent = 'Odesílám...';

    const formData = new FormData();
    formData.append('message', message);
    // CSRF token — použij embedded hodnotu
    formData.append('_csrf_token', document.getElementById('reply-csrf-token').value);

    try {
        const res = await fetch(`/admin/support/${ticketId}/reply`, {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
        });

        if (res.ok || res.redirected) {
            document.getElementById('reply-message').value = '';
            // Znovu načti zprávy
            const data = await fetch(`/admin/support/${ticketId}/messages`).then(r => r.json());
            renderMessages(data.messages ?? []);

            // Aktualizuj badge na Odpovězeno
            const badge = document.getElementById('chat-status-badge');
            badge.textContent = 'Odpovězeno';
            badge.className   = 'inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800';
        }
    } catch (err) {
        alert('Chyba při odesílání odpovědi.');
    } finally {
        submitBtn.disabled    = false;
        submitBtn.textContent = 'Odeslat';
    }
});

// Zavření modalů kliknutím mimo
['modal-ticket', 'modal-chat'].forEach(id => {
    document.getElementById(id)?.addEventListener('click', function(e) {
        if (e.target === this) this.classList.add('hidden');
    });
});
</script>
{% endblock %}
