{% extends 'base.html.twig' %}

{% block title %}Editace uživatele{% endblock %}

{% block body %}
    <div class="p-6 max-w-2xl mx-auto">

        {# Breadcrumb #}
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-6">
            <a href="{{ path('admin_users_index') }}" class="hover:text-indigo-600 transition-colors">Uživatelé</a>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            <span class="text-gray-900 font-medium">{{ user.name ?? user.email }}</span>
        </div>

        <div class="bg-white border border-gray-200 rounded-xl p-6">

            {# Avatar + info #}
            <div class="flex items-center gap-4 mb-6 pb-6 border-b border-gray-100">
                <div class="w-14 h-14 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center flex-shrink-0">
                <span class="text-white text-lg font-bold">
                    {{ (user.name ?? user.email)|slice(0,1)|upper }}
                </span>
                </div>
                <div>
                    <h1 class="text-xl font-bold text-gray-900">{{ user.name ?? user.email }}</h1>
                    <p class="text-sm text-gray-500">Člen od {{ user.createdAt|date('d.m.Y') }}</p>
                </div>
            </div>

            {% if error %}
                <div class="mb-4 px-4 py-3 bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg">
                    {{ error }}
                </div>
            {% endif %}

            <form method="post" class="space-y-5">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('user_edit_' ~ user.id) }}">

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Jméno</label>
                        <input type="text" name="name"
                               value="{{ user.name }}"
                               placeholder="Jan Novák"
                               class="w-full px-4 py-2.5 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Email <span class="text-red-500">*</span></label>
                        <input type="email" name="email" required
                               value="{{ user.email }}"
                               class="w-full px-4 py-2.5 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                            Nové heslo
                            <span class="text-gray-400 font-normal">(ponech prázdné = beze změny)</span>
                        </label>
                        <input type="password" name="password"
                               placeholder="Min. 6 znaků"
                               class="w-full px-4 py-2.5 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Role</label>
                        <select name="role"
                                class="w-full px-4 py-2.5 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition bg-white">
                            <option value="ROLE_USER" {{ 'ROLE_ADMIN' not in user.roles ? 'selected' }}>Uživatel</option>
                            <option value="ROLE_ADMIN" {{ 'ROLE_ADMIN' in user.roles ? 'selected' }}>Administrátor</option>
                        </select>
                    </div>
                </div>

                <div class="flex items-center justify-end gap-3 pt-2 border-t border-gray-100">
                    <a href="{{ path('admin_users_index') }}"
                       class="px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 rounded-lg transition-colors">
                        Zrušit
                    </a>
                    <button type="submit"
                            class="px-6 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium rounded-lg transition-colors">
                        Uložit změny
                    </button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
